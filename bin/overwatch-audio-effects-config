#!/bin/bash

# Keep EasyEffects out of the desktop audio path. The session moves game
# streams to the effects sink itself, so EasyEffects must not capture every
# stream. A captured stream makes WirePlumber save a permanent
# easyeffects_sink target, and each EasyEffects failure then silences that
# application. The service unit runs this before each EasyEffects start,
# which also undoes a manual change from the EasyEffects interface.

set -euo pipefail

readonly RC_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/easyeffects/db/easyeffectsrc"
readonly GROUP="EffectsPipelines"

set_group_key() {
	local file="$1"
	local key="$2"
	local value="$3"
	local temporary

	temporary="$(mktemp)"
	awk -v group="[$GROUP]" -v key="$key" -v value="$value" '
		BEGIN { in_group = 0; done = 0 }
		/^\[/ {
			if (in_group && !done) {
				print key "=" value
				done = 1
			}
			in_group = ($0 == group)
		}
		{
			if (in_group && !done && index($0, key "=") == 1) {
				print key "=" value
				done = 1
				next
			}
			print
		}
		END {
			if (!done) {
				if (!in_group) {
					print group
				}
				print key "=" value
			}
		}
	' "$file" > "$temporary"
	install -m 600 -- "$temporary" "$file"
	rm -f -- "$temporary"
}

mkdir -p "$(dirname -- "$RC_FILE")"
if [[ ! -f "$RC_FILE" ]]; then
	(umask 077 && : > "$RC_FILE")
fi

set_group_key "$RC_FILE" processAllOutputs false
set_group_key "$RC_FILE" processAllInputs false
