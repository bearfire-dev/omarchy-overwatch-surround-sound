#!/bin/bash

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
readonly CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/overwatch-audio/session.conf"
readonly PROFILE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/overwatch-audio/profiles"
readonly STATE_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/overwatch-audio"
readonly PREVIOUS_SINK_FILE="$STATE_DIR/previous-sink"
readonly ACTIVE_FILE="$STATE_DIR/active"
readonly OBSERVER="$SCRIPT_DIR/overwatch-audio-observe"
readonly ACTIVATION_BACKOFF_START_SECONDS=5
readonly ACTIVATION_BACKOFF_MAX_SECONDS=60

ACTIVATION_ERROR=""

if [[ ! -r "$CONFIG_FILE" ]]; then
	printf 'Missing configuration: %s\n' "$CONFIG_FILE" >&2
	exit 1
fi

# shellcheck source=/dev/null
source "$CONFIG_FILE"

STREAM_PATTERN="${STREAM_PATTERN:-${PROCESS_PATTERN:-}}"

require_config_value() {
	local name="$1"
	local pattern="$2"

	if [[ ! "${!name:-}" =~ $pattern ]]; then
		printf 'Invalid configuration value for %s in %s\n' "$name" "$CONFIG_FILE" >&2
		exit 1
	fi
}

require_config_value HEADSET_SINK '^.+$'
require_config_value PRESET_NAME '^.+$'
require_config_value PROCESS_PATTERN '^.+$'
require_config_value STREAM_PATTERN '^.+$'
require_config_value POLL_INTERVAL '^[0-9]+(\.[0-9]+)?$'
require_config_value HEALTH_INTERVAL '^[0-9]+$'

# The base configuration is the default profile. Files under PROFILE_DIR add
# one game each and reuse the same keys.
declare -a PROFILE_NAMES=("default")
declare -a PROFILE_PROCESS_PATTERNS=("$PROCESS_PATTERN")
declare -a PROFILE_STREAM_PATTERNS=("$STREAM_PATTERN")
declare -a PROFILE_PRESETS=("$PRESET_NAME")

load_profile() {
	local file="$1"
	# Locals shield the base configuration from profile assignments.
	# shellcheck disable=SC2034
	local HEADSET_SINK="" POLL_INTERVAL="" HEALTH_INTERVAL=""
	local PROCESS_PATTERN=""
	local STREAM_PATTERN=""
	local PRESET_NAME=""

	# shellcheck source=/dev/null
	source "$file"

	if [[ -z "$PROCESS_PATTERN" || -z "$PRESET_NAME" ]]; then
		printf 'Invalid profile %s: PROCESS_PATTERN and PRESET_NAME are required.\n' "$file" >&2
		exit 1
	fi

	PROFILE_NAMES+=("$(basename -- "$file" .conf)")
	PROFILE_PROCESS_PATTERNS+=("$PROCESS_PATTERN")
	PROFILE_STREAM_PATTERNS+=("${STREAM_PATTERN:-$PROCESS_PATTERN}")
	PROFILE_PRESETS+=("$PRESET_NAME")
}

for profile_file in "$PROFILE_DIR"/*.conf; do
	if [[ -e "$profile_file" ]]; then
		load_profile "$profile_file"
	fi
done
unset profile_file

select_profile() {
	ACTIVE_PROFILE_INDEX="$1"
	ACTIVE_PROFILE_NAME="${PROFILE_NAMES[$1]}"
	ACTIVE_STREAM_PATTERN="${PROFILE_STREAM_PATTERNS[$1]}"
	ACTIVE_PRESET="${PROFILE_PRESETS[$1]}"
}

select_profile 0

profile_running() {
	pgrep -ix -- "${PROFILE_PROCESS_PATTERNS[$1]}" >/dev/null
}

running_profile() {
	local index

	for (( index = 0; index < ${#PROFILE_NAMES[@]}; index++ )); do
		if profile_running "$index"; then
			printf '%s\n' "$index"
			return 0
		fi
	done

	return 1
}

profile_index_by_name() {
	local name="$1"
	local index

	for (( index = 0; index < ${#PROFILE_NAMES[@]}; index++ )); do
		if [[ "${PROFILE_NAMES[$index]}" == "$name" ]]; then
			printf '%s\n' "$index"
			return 0
		fi
	done

	return 1
}

any_profile_running() {
	running_profile >/dev/null
}

log() {
	printf '%s overwatch-audio: %s\n' "$(date --iso-8601=seconds)" "$*"
}

observe_pipeline() {
	"$OBSERVER" pipeline "$@" || true
}

easy_effects_ready() {
	[[ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/EasyEffectsServer" ]]
}

easy_effects_cli() {
	# The CLI starts Qt before it reaches the daemon socket, and Qt aborts
	# when no display platform is available. The offscreen platform makes
	# every call independent of the session display.
	env -u DISPLAY -u WAYLAND_DISPLAY QT_QPA_PLATFORM=offscreen easyeffects "$@"
}

wait_for_easy_effects() {
	for _ in {1..50}; do
		if easy_effects_ready; then
			return 0
		fi
		sleep 0.1
	done

	log "EasyEffects did not become ready"
	return 1
}

headset_available() {
	pactl list sinks short | awk -v sink="$HEADSET_SINK" '$2 == sink { found = 1 } END { exit !found }'
}

sink_available() {
	local sink="$1"

	pactl list sinks short | awk -v sink="$sink" '$2 == sink { found = 1 } END { exit !found }'
}

move_overwatch_streams() {
	local input
	local inputs
	local target_sink="easyeffects_sink"

	if ! sink_available "$target_sink"; then
		return 0
	fi

	inputs="$(
		pactl --format=json list sink-inputs | jq -r --arg pattern "$ACTIVE_STREAM_PATTERN" '
			.[]
			| select(
				[
					.properties["application.name"] // "",
					.properties["application.process.binary"] // "",
					.properties["media.name"] // ""
				]
				| any(test($pattern; "i"))
			)
			| .index
		'
	)"

	while IFS= read -r input; do
		[[ -n "$input" ]] || continue
		pactl move-sink-input "$input" "$target_sink" || true
	done <<< "$inputs"
}

overwatch_streams_on_effects() {
	local result
	local target_index

	target_index="$(
		pactl --format=json list sinks | jq -r '
			.[]
			| select(.name == "easyeffects_sink")
			| .index
		' | head -n 1
	)"
	[[ -n "$target_index" ]] || return 1

	result="$(
		pactl --format=json list sink-inputs | jq -r --argjson target "$target_index" --arg pattern "$ACTIVE_STREAM_PATTERN" '
			[
				.[]
				| select(
					[
						.properties["application.name"] // "",
						.properties["application.process.binary"] // "",
						.properties["media.name"] // ""
					]
					| any(test($pattern; "i"))
				)
				| select(.sink != $target)
			]
			| length
		'
	)"

	[[ "$result" == "0" ]]
}

equalizer_loaded() {
	# A silent pipeline reports idle or suspended, which is still healthy.
	pw-dump | jq -e '
		.[]
		| select(.info.props["node.name"] == "ee_soe_equalizer")
		| select(.info.state == "running" or .info.state == "idle" or .info.state == "suspended")
	' >/dev/null
}

audio_healthy() {
	local bypass_state
	local loaded_preset

	headset_available || return 1
	easy_effects_ready || return 1
	sink_available "easyeffects_sink" || return 1
	[[ "$(pactl get-default-sink)" == "$HEADSET_SINK" ]] || return 1

	bypass_state="$(easy_effects_cli --bypass 3 2>/dev/null || true)"
	[[ "$bypass_state" == "2" ]] || return 1

	loaded_preset="$(easy_effects_cli --last-loaded-preset output 2>/dev/null || true)"
	[[ "$loaded_preset" == "$ACTIVE_PRESET" ]] || return 1

	equalizer_loaded || return 1
	overwatch_streams_on_effects
}

apply_update_after_game() {
	while true; do
		while any_profile_running; do
			sleep 2
		done

		sleep 3
		if ! any_profile_running; then
			break
		fi
	done

	systemctl --user restart easyeffects.service
	systemctl --user restart overwatch-audio-session.service
	log "activated the deferred update"
}

record_previous_sink() {
	local current_sink

	mkdir -p "$STATE_DIR"
	if [[ -e "$PREVIOUS_SINK_FILE" ]]; then
		return 0
	fi

	current_sink="$(pactl get-default-sink)"
	if [[ "$current_sink" == "easyeffects_sink" ]]; then
		# An empty record prevents a restore to the effects sink.
		: > "$PREVIOUS_SINK_FILE"
	else
		printf '%s\n' "$current_sink" > "$PREVIOUS_SINK_FILE"
	fi
}

configure_audio() {
	ACTIVATION_ERROR="the headset sink is not available"
	if ! headset_available; then
		log "The configured headset sink is not available"
		return 1
	fi

	ACTIVATION_ERROR="EasyEffects did not become ready"
	wait_for_easy_effects || return 1

	ACTIVATION_ERROR="the preset load failed"
	easy_effects_cli --load-preset "$ACTIVE_PRESET" || return 1

	ACTIVATION_ERROR="the bypass toggle failed"
	easy_effects_cli --bypass 2 || return 1

	# The default sink changes last, after the effects are confirmed working.
	# A failed activation then never moves the user's audio output.
	ACTIVATION_ERROR="the default sink change failed"
	record_previous_sink
	pactl set-default-sink "$HEADSET_SINK" || return 1

	ACTIVATION_ERROR=""
	move_overwatch_streams
}

activate_audio() {
	mkdir -p "$STATE_DIR"

	if ! configure_audio; then
		deactivate_audio
		return 1
	fi

	printf '%s\n' "$ACTIVE_PROFILE_NAME" > "$ACTIVE_FILE"
	log "enabled preset '$ACTIVE_PRESET' for profile '$ACTIVE_PROFILE_NAME'"
}

repair_audio() {
	if configure_audio && audio_healthy; then
		printf '%s\n' "$ACTIVE_PROFILE_NAME" > "$ACTIVE_FILE"
		log "repaired the active Overwatch audio path"
		observe_pipeline "pipeline_repair" "success" "The automatic repair restored the Overwatch audio path."
		return 0
	fi

	ACTIVATION_ERROR="${ACTIVATION_ERROR:-the health check failed after the repair}"
	log "audio repair failed and will retry: $ACTIVATION_ERROR"
	observe_pipeline "pipeline_repair" "error" "The Overwatch audio path repair failed: $ACTIVATION_ERROR."
	return 1
}

deactivate_audio() {
	local previous_sink=""

	# Leave EasyEffects alone unless this service owns an active session.
	if [[ ! -e "$ACTIVE_FILE" && ! -e "$PREVIOUS_SINK_FILE" ]]; then
		return 0
	fi

	if [[ -s "$PREVIOUS_SINK_FILE" ]]; then
		previous_sink="$(<"$PREVIOUS_SINK_FILE")"
		if sink_available "$previous_sink"; then
			pactl set-default-sink "$previous_sink" || true
		fi
	fi

	if easy_effects_ready; then
		sleep 0.2
		easy_effects_cli --bypass 1 || true
	fi

	rm -f "$PREVIOUS_SINK_FILE" "$ACTIVE_FILE"
	log "bypassed effects and restored the prior output"
}

watch_session() {
	local next_health_check=0
	local next_activation=0
	local activation_backoff=0
	local session_active=0
	local active_name=""
	local matched_index=""

	mkdir -p "$STATE_DIR"
	exec 9>"$STATE_DIR/watcher.lock"
	if ! flock -n 9; then
		log "another watcher is active"
		exit 0
	fi

	if [[ -s "$ACTIVE_FILE" ]]; then
		read -r active_name < "$ACTIVE_FILE"
	fi
	if [[ -n "$active_name" ]] \
		&& matched_index="$(profile_index_by_name "$active_name")" \
		&& profile_running "$matched_index"; then
		select_profile "$matched_index"
		session_active=1
		if ! audio_healthy; then
			repair_audio || true
		fi
	else
		deactivate_audio
	fi
	trap 'if (( session_active )); then deactivate_audio; fi' EXIT
	trap 'exit 0' INT TERM

	while true; do
		if (( session_active )); then
			if ! profile_running "$ACTIVE_PROFILE_INDEX"; then
				deactivate_audio
				session_active=0
				activation_backoff=0
				next_activation=0
			elif (( SECONDS >= next_health_check )); then
				if ! audio_healthy; then
					repair_audio || true
				fi
				next_health_check=$((SECONDS + HEALTH_INTERVAL))
			fi
		elif matched_index="$(running_profile)"; then
			if (( SECONDS >= next_activation )); then
				select_profile "$matched_index"
				if activate_audio; then
					session_active=1
					activation_backoff=0
					next_health_check=$((SECONDS + HEALTH_INTERVAL))
				else
					if (( activation_backoff == 0 )); then
						activation_backoff="$ACTIVATION_BACKOFF_START_SECONDS"
					else
						activation_backoff=$((activation_backoff * 2))
					fi
					if (( activation_backoff > ACTIVATION_BACKOFF_MAX_SECONDS )); then
						activation_backoff="$ACTIVATION_BACKOFF_MAX_SECONDS"
					fi
					next_activation=$((SECONDS + activation_backoff))
					log "activation failed (${ACTIVATION_ERROR:-unknown cause}) and will retry in ${activation_backoff}s"
					observe_pipeline "session_activation" "error" "The automatic game audio session could not start: ${ACTIVATION_ERROR:-unknown cause}."
				fi
			fi
		else
			activation_backoff=0
			next_activation=0
		fi

		sleep "$POLL_INTERVAL"
	done
}

show_status() {
	local matched_index=""

	if matched_index="$(running_profile)"; then
		select_profile "$matched_index"
	fi

	printf 'Game: %s\n' "$([[ -n "$matched_index" ]] && printf running || printf stopped)"
	printf 'Headset: %s\n' "$(headset_available && printf available || printf unavailable)"
	printf 'EasyEffects: %s\n' "$(easy_effects_ready && printf ready || printf stopped)"
	printf 'Effects: %s\n' "$([[ -e "$ACTIVE_FILE" ]] && printf active || printf bypassed)"
	if [[ -n "$matched_index" ]]; then
		printf 'Profile: %s\n' "$ACTIVE_PROFILE_NAME"
		printf 'Pipeline: %s\n' "$(audio_healthy && printf healthy || printf needs-repair)"
	fi
	printf 'Default sink: %s\n' "$(pactl get-default-sink)"
	printf 'Preset: %s\n' "$ACTIVE_PRESET"
}

enable_services() {
	systemctl --user enable --now easyeffects.service overwatch-audio-session.service
}

rollback_services() {
	systemctl --user stop overwatch-audio-apply-update.service 2>/dev/null || true
	systemctl --user disable --now overwatch-audio-session.service easyeffects.service || true
	deactivate_audio
	if command -v easyeffects >/dev/null && easy_effects_ready; then
		easy_effects_cli --quit || true
	fi
	log "automatic audio is disabled"
}

case "${1:-watch}" in
	watch)
		watch_session
		;;
	on)
		if matched_index="$(running_profile)"; then
			select_profile "$matched_index"
		fi
		activate_audio
		;;
	off)
		deactivate_audio
		;;
	status)
		show_status
		;;
	health)
		if matched_index="$(running_profile)"; then
			select_profile "$matched_index"
		fi
		audio_healthy
		;;
	apply-update-after-game)
		apply_update_after_game
		;;
	enable)
		enable_services
		;;
	rollback)
		rollback_services
		;;
	*)
		printf 'Usage: %s {watch|on|off|status|health|enable|rollback}\n' "${0##*/}" >&2
		exit 2
		;;
esac
