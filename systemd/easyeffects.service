[Unit]
Description=EasyEffects audio processor
After=pipewire.service pipewire-pulse.service
Requires=pipewire.service pipewire-pulse.service
StartLimitIntervalSec=5min
StartLimitBurst=5

[Service]
Type=simple
Environment=QT_QPA_PLATFORM=offscreen
Environment=DISABLE_RTKIT=1
ExecStart=/usr/bin/easyeffects --service-mode
ExecStop=/usr/bin/easyeffects --quit
ExecStopPost=-%h/.local/bin/overwatch-audio-observe service-exit %n ${SERVICE_RESULT} ${EXIT_CODE} ${EXIT_STATUS}
Restart=on-failure
RestartSec=1
RestartSteps=6
RestartMaxDelaySec=60
TimeoutStopSec=10

[Install]
WantedBy=default.target
